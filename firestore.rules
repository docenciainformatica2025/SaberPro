rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- FUNCIONES DE AYUDA (SEGURIDAD MILITAR 2026) ---
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }
    
    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : {};
    }

    function isRootEmail(email) {
      let rootEmails = ['antonio_rburgos@msn.com', 'jarbugos40@gmail.com'];
      return email != null && email.lower() in rootEmails;
    }
    
    function isRootToken() {
      return isAuthenticated() && isRootEmail(request.auth.token.email);
    }

    function hasRole(role) {
      return isAuthenticated() && (
        getUserData().get('role', 'none') == role || 
        (role == 'admin' && isRootToken())
      );
    }

    function isAdmin() { 
      return isRootToken() || hasRole('admin') || isRootEmail(getUserData().get('email', '')); 
    }
    function isTeacher() { return hasRole('teacher'); }
    
    function isRoot(userId) {
      return isAuthenticated() && (
        isRootEmail(request.auth.token.email) ||
        isRootEmail(get(/databases/$(database)/documents/users/$(userId)).data.get('email', ''))
      );
    }

    // Validación de Sanitización (Anti-Injection)
    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen && !val.matches('.*<script.*');
    }

    // --- REGLAS DE ACCESO PÚBLICO (RANKING) ---
    match /users/{userId} {
      // Permitir lectura de perfiles a cualquier usuario logueado (necesario para Leaderboard)
      allow get, list: if request.auth != null;
      
      // Escritura restringida al propio usuario y administradores
      allow create: if request.auth != null && request.auth.uid == userId 
                    && (request.resource.data.get('role', null) != 'admin' || isRootEmail(request.auth.token.email));
      
      allow update: if (isOwner(userId) || isAdmin()) 
                    && (!isRoot(userId) || (request.auth.uid == userId))
                    && (
                      request.resource.data.get('role', null) == resource.data.get('role', null) || 
                      (resource.data.get('role', null) == null && request.resource.data.get('role', null) in ['student', 'teacher']) ||
                      isRootEmail(request.auth.token.email)
                    )
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fullName']) 
                        || isValidString(request.resource.data.get('fullName', ''), 100));
      
      allow delete: if isAdmin() && !isRoot(userId);
    }

    // --- REGLAS DE NEGOCIO Y OPERACIONES ---

    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid 
                    && request.resource.data.amount is number;
      allow update, delete: if isAdmin();
    }

    match /results/{resultId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isTeacher() || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid 
                    && request.resource.data.score is number;
      allow update, delete: if isAdmin();
    }

    match /classrooms/{classId} {
      allow read: if isAuthenticated();
      allow create: if isTeacher() || isAdmin();
      allow update: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /planners/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /questions/{questionId} {
      allow read: if isAuthenticated(); 
      allow write: if isAdmin();
    }

    match /system/{configId} {
      allow read: if true;
      allow write: if isRoot(request.auth.uid); // Solo root toca configuración de sistema
    }

    match /admin_audit/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated(); // Permitir logs de sistema
      allow update, delete: if false;
    }

    match /library/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /assignments/{docId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isTeacher() || isAdmin());
      allow create: if isTeacher() || isAdmin();
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /subscriptions/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isRoot(request.auth.uid); // Solo root/backend gestiona suscripciones
    }

    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isAdmin() || request.auth.token.email in ['antonio_rburgos@msn.com', 'jarbugos40@gmail.com']);
      allow delete: if isAuthenticated() && isAdmin();
      allow update: if isAdmin() || (isAuthenticated() && !resource.data.isUsed && request.resource.data.isUsed == true);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}