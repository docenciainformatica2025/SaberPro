# --- CONFIGURACIÓN PÚBLICA (CLIENTE) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=XXXXXXXXXX
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# --- CONFIGURACIÓN PRIVADA (SERVIDOR - SEGURIDAD MILITAR) ---
# NUNCA compartas estas variables ni las subas a control de versiones.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# Master Security (Comma separated emails)
NEXT_PUBLIC_ADMIN_EMAILS=admin1@example.com,admin2@example.com
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Branding & Ops
NEXT_PUBLIC_AUTHOR_NAME=Author Name
NEXT_PUBLIC_COMPANY_NAME=Company Name
NEXT_PUBLIC_CONTACT_EMAIL=support@example.com
NEXT_PUBLIC_SALES_EMAIL=sales@example.com
